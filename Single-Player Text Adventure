// ==========================================
// 1. PLAYER CLASS
// ==========================================
class Player {
private:
    int hp;
    int maxHp;
    int attack;
    int level;
    int xp;
    int gold;
    int x;
    int y;
    vector<string> inventory;

public:
    Player() {
        hp = 100;
        maxHp = 100;
        attack = 20;
        level = 1;
        xp = 0;
        gold = 0;
        x = 2;
        y = 0;
        inventory.push_back("Potion");
    }

    // Getters
    int getHp() const { return hp; }
    int getMaxHp() const { return maxHp; }
    int getAttack() const { return attack; }
    int getLevel() const { return level; }
    int getXp() const { return xp; }
    int getGold() const { return gold; }
    int getX() const { return x; }
    int getY() const { return y; }
    size_t getPotionCount() const { return inventory.size(); }

    // Setters / Modifiers
    void setPosition(int nx, int ny) { x = nx; y = ny; }
    void modifyGold(int amount) { gold += amount; }
    void damage(int amount) { 
        hp -= amount; 
        if (hp < 0) hp = 0; 
    }
    
    void move(char direction, int maxRows, int maxCols) {
        if (direction == 'w' || direction == 'W') x--;
        else if (direction == 's' || direction == 'S') x++;
        else if (direction == 'a' || direction == 'A') y--;
        else if (direction == 'd' || direction == 'D') y++;
        
        // Bounds checking
        if (x < 0) x = 0;
        if (x >= maxRows) x = maxRows - 1;
        if (y < 0) y = 0;
        if (y >= maxCols) y = maxCols - 1;
    }

    void usePotion() {
        if (!inventory.empty()) {
            hp += 20;
            if (hp > maxHp) hp = maxHp;
            inventory.pop_back();
            cout << "You used a potion! +20 HP. Potions left: " << inventory.size() << "\n";
        } else {
            cout << "No potions left!\n";
        }
    }

    void addPotion() {
        inventory.push_back("Potion");
    }

    void gainXp(int amount) {
        xp += amount;
        cout << "You gained " << amount << " XP!\n";
        if (xp >= 100) {
            level++;
            xp -= 100;
            maxHp += 20;
            hp = maxHp; // Full heal on level up
            attack += 5;
            cout << "\n✨ LEVEL UP! You reached Level " << level << "! ✨\n";
            cout << "Max HP increased to " << maxHp << " (Fully Healed!)\n";
            cout << "Attack increased to " << attack << "!\n";
        }
    }

    // Manual load injection
    void loadState(int h, int mh, int atk, int lvl, int exp, int g, int px, int py, int potions) {
        hp = h; maxHp = mh; attack = atk; level = lvl; xp = exp; gold = g; x = px; y = py;
        inventory.clear();
        for (int i = 0; i < potions; i++) inventory.push_back("Potion");
    }
};

// ==========================================
// 2. ENEMY CLASS
// ==========================================
class Enemy {
private:
    int hp;
    int attack;

public:
    Enemy() {
        hp = 60 + rand() % 41;    // 60-100 HP
        attack = 10 + rand() % 11; // 10-20 ATK
    }

    int getHp() const { return hp; }
    int getAttack() const { return attack; }
    bool isDefeated() const { return hp <= 0; }

    void takeDamage(int amount) {
        hp -= amount;
        if (hp < 0) hp = 0;
    }
};

// ==========================================
// 3. MAP CLASS
// ==========================================
class GameMap {
private:
    vector<vector<char>> grid;

public:
    GameMap() {
        // Default Chapter 1 layout
        grid = {
            {'.', '.', '.', 'E', '.'},
            {'.', 'T', '.', 'X', '.'},
            {'.', '.', '.', 'E', '.'},
            {'.', '.', '.', '.', '.'},
            {'.', '.', 'E', '.', '.'}
        };
    }

    int getRows() const { return grid.size(); }
    int getCols() const { return grid[0].size(); }
    char getTile(int x, int y) const { return grid[x][y]; }
    void setTile(int x, int y, char val) { grid[x][y] = val; }

    void loadChapter2() {
        grid = {
            {'E', '.', '.', '.', 'E'},
            {'.', 'X', '.', 'T', '.'},
            {'E', '.', '.', '.', 'E'}, // Clear center for spawn point
            {'.', 'T', '.', 'X', '.'},
            {'E', '.', '.', '.', 'E'}
        };
    }

    void display(int px, int py) {
        for (int i = 0; i < grid.size(); i++) {
            for (int j = 0; j < grid[i].size(); j++) {
                if (i == px && j == py) cout << "P ";
                else cout << grid[i][j] << " ";
            }
            cout << "\n";
        }
    }
};

// ==========================================
// 4. SAVE MANAGER CLASS 
// ==========================================
class SaveManager {
public:
    static void saveGame(const Player& player, const GameMap& map, int chapter, int enemiesRemaining) {
        ofstream file("savegame.txt");
        if (file.is_open()) {
            file << player.getHp() << "\n" << player.getMaxHp() << "\n" << player.getAttack() << "\n"
                 << player.getLevel() << "\n" << player.getXp() << "\n" << chapter << "\n"
                 << player.getX() << "\n" << player.getY() << "\n" << player.getPotionCount() << "\n"
                 << player.getGold() << "\n" << enemiesRemaining << "\n";

            for (int i = 0; i < map.getRows(); i++) {
                for (int j = 0; j < map.getCols(); j++) {
                    file << map.getTile(i, j);
                }
                file << "\n";
            }
            file.close();
            cout << "Game saved successfully!\n";
        } else {
            cout << "Error saving game!\n";
        }
    }

    static bool loadGame(Player& player, GameMap& map, int& chapter, int& enemiesRemaining) {
        ifstream file("savegame.txt");
        if (!file.is_open()) return false;

        int hp, maxHp, attack, level, xp, playerX, playerY, potions, gold;
        file >> hp >> maxHp >> attack >> level >> xp >> chapter >> playerX >> playerY >> potions >> gold >> enemiesRemaining;

        player.loadState(hp, maxHp, attack, level, xp, gold, playerX, playerY, potions);

        for (int i = 0; i < 5; i++) {
            for (int j = 0; j < 5; j++) {
                char tile;
                file >> tile;
                map.setTile(i, j, tile);
            }
        }
        file.close();
        return true;
    }
};

// ==========================================
// 5. GAME ENGINE ORCHESTRATOR
// ==========================================
class Game {
private:
    Player player;
    GameMap map;
    int chapter;
    int enemiesRemaining;

    void battle() {
        Enemy enemy;
        cout << "\n--- Battle Start! ---\n";
        bool isDefending = false;

        while (player.getHp() > 0 && !enemy.isDefeated()) {
            cout << "\nYour HP: " << player.getHp() << "/" << player.getMaxHp() 
                 << " | Enemy HP: " << enemy.getHp() << "\n";
            isDefending = false;

            int choice;
            while (true) {
                cout << "1. Attack\n2. Defend\n3. Use Potion\nChoose action: ";
                if (!(cin >> choice)) {
                    cin.clear(); cin.ignore(1000, '\n');
                    cout << "Invalid input! Try again.\n";
                    continue;
                }

                if (choice == 1) {
                    cout << "You attack the enemy!\n";
                    enemy.takeDamage(player.getAttack());
                    break;
                } else if (choice == 2) {
                    cout << "You brace for the enemy attack!\n";
                    isDefending = true;
                    break;
                } else if (choice == 3) {
                    if (player.getPotionCount() > 0) {
                        player.usePotion();
                        break;
                    } else {
                        cout << "No potions left!\n";
                    }
                } else {
                    cout << "Invalid choice!\n";
                }
            }

            if (enemy.isDefeated()) {
                cout << "Enemy defeated!\n";
                player.modifyGold(25);
                enemiesRemaining--;
                player.gainXp(40 + rand() % 21);
                break;
            }

            // Enemy Turn Phase
            if (rand() % 2 == 0) {
                cout << "Enemy attacks!\n";
                int dmg = enemy.getAttack();
                if (isDefending) {
                    cout << "You reduced the damage!\n";
                    dmg /= 2;
                }
                player.damage(dmg);
            } else {
                cout << "Enemy hesitates...\n";
            }
        }
        cout << "--- Battle End ---\n";
    }

    void gameLoop() {
        char move;
        while (true) {
            cout << "\n--- Map (Chapter " << chapter << ") ---\n";
            map.display(player.getX(), player.getY());

            cout << "LVL: " << player.getLevel() << " (" << player.getXp() << "/100 XP)"
                 << " | HP: " << player.getHp() << "/" << player.getMaxHp()
                 << " | ATK: " << player.getAttack()
                 << " | Potions: " << player.getPotionCount()
                 << " | Gold: " << player.getGold()
                 << " | Enemies Left: " << enemiesRemaining << "\n";

            cout << "\nMove (W/A/S/D, V to save, Q to quit): ";
            cin >> move;

            if (move == 'q' || move == 'Q') break;
            if (move == 'v' || move == 'V') {
                SaveManager::saveGame(player, map, chapter, enemiesRemaining);
                continue;
            }

            player.move(move, map.getRows(), map.getCols());
            char tile = map.getTile(player.getX(), player.getY());

            if (tile == 'E') {
                cout << "A wild enemy appears!\n";
                battle();
                map.setTile(player.getX(), player.getY(), '.');
            } else if (tile == 'T') {
                cout << "You found treasure! +50 Gold and a Potion!\n";
                player.modifyGold(50);
                player.addPotion();
                map.setTile(player.getX(), player.getY(), '.');
            } else if (tile == 'X') {
                cout << "You stepped on a trap! -10 HP\n";
                player.damage(10);
                map.setTile(player.getX(), player.getY(), '.');
            }

            if (player.getHp() <= 0) {
                cout << "\n================================\nGame Over!\n================================\n";
                break;
            }

            // Progression Architecture
            if (enemiesRemaining == 0) {
                cout << "\n============================================\n"
                     << "🎉 CHAPTER " << chapter << " COMPLETE! 🎉\n"
                     << "============================================\n";
                chapter++;

                if (chapter > 2) {
                    cout << "\n============================================\n"
                         << "YOU WIN! You have completely cleansed the realm!\n"
                         << "============================================\n";
                    break;
                } else {
                    cout << "\nAdvancing to Chapter " << chapter << "...\n\n";
                    map.loadChapter2();
                    player.setPosition(2, 2);
                    enemiesRemaining = 5; // Capped correctly to match Chapter 2 grid
                    SaveManager::saveGame(player, map, chapter, enemiesRemaining);
                }
            }
        }
    }

public:
    Game() {
        chapter = 1;
        enemiesRemaining = 3;
    }

    void startNewGame() {
        player = Player();
        map = GameMap();
        chapter = 1;
        enemiesRemaining = 3;
        cout << "\n================================\nThe kingdom is overrun by monsters.\n================================\n";
        gameLoop();
    }

    void loadExistingGame() {
        if (SaveManager::loadGame(player, map, chapter, enemiesRemaining)) {
            cout << "Game loaded successfully!\n";
            gameLoop();
        } else {
            cout << "No saved game found!\n";
        }
    }

    void run() {
        int choice;
        while (true) {
            cout << "\n===== RPG Game =====\n1. Start New Game\n2. Load Game\n3. Exit\nEnter choice: ";
            if (!(cin >> choice)) {
                cin.clear(); cin.ignore(1000, '\n');
                cout << "Invalid input.\n";
                continue;
            }
            if (choice == 1) startNewGame();
            else if (choice == 2) loadExistingGame();
            else if (choice == 3) { cout << "Exiting...\n"; break; }
            else cout << "Invalid choice.\n";
        }
    }
};

